# Your event ID, the only required variable.
# Find it in the URL when viewing your event in app.happily.events
# (e.g. app.happily.events/<EVENT_ID>/...)
HAPPILY_EVENT_ID=

# Everything below is an optional override. Defaults point at the
# production API, so most setups never need to uncomment these.

# Target a different API, e.g. a locally running CMS.
# HAPPILY_API_BASE_URL=https://app.happily.events
# HAPPILY_API_SCHEMA_URL=https://app.happily.events/api/openapi.json

# The site fetches published ("prod") event data by default.
# While iterating on a draft, open any page with ?preview=true,
# or set this to "staging" to always fetch the draft.
# HAPPILY_EVENT_ENV=staging
